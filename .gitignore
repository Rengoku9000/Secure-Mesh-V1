# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Standalone binary staged by `npm run app:stage`
dist-app

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- SecureMesh: never commit secrets or node state ---
# Cryptographic key material of any form
*.key
*.pem
*.p12
*.pfx
identity.json
node_identity*
secrets/

# Local node databases (contain operational data)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Environment / credentials
.env
.env.*
!.env.example

# Local AI model weights (large, provisioned out of band; see docs/ai/PROVISIONING.md)
ai/models/*
!ai/models/.gitkeep
!ai/models/README.md
*.gguf
*.onnx
*.safetensors

# Local inference runtime: third-party prebuilt binaries, provisioned by the
# operator and verified against ai/models/README.md. Never vendored here.
ai/runtime/

# Operator-provisioned offline map data.
#
# Not committed: it is chosen per deployment, can be tens of megabytes, and
# carries licensing obligations that depend on its source (OSM extracts are
# ODbL). The slot and its documentation are tracked; the data is not.
map/*.geojson

# SecureMesh-SLM training environment and base model weights.
#
# Two rules, deliberately narrow. Everything else under training/ — the
# scripts, the authored scenario families, the dataset and its manifest, the
# evaluation results — is exactly the material that makes a run reproducible
# and is tracked. Only the reconstructable bulk is excluded:
#
#   .venv    ~3.3 GB, rebuilt from the documented install commands
#   models   ~2.9 GB, re-downloadable from Qwen/Qwen2.5-1.5B-Instruct
#   tools    third-party source (llama.cpp) cloned by the setup scripts,
#            vendored as a separate git checkout rather than tracked here
#   results  training run outputs: checkpoints, optimizer state, merged and
#            quantized model weights — multi-GB, regenerated by re-running
#            the pipeline against the tracked scripts and dataset
training/.venv/
training/models/
training/tools/
training/results/

# Python bytecode caches
__pycache__/
*.pyc
