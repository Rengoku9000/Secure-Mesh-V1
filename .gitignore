# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Standalone binary staged by `npm run app:stage`
dist-app

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- SecureMesh: never commit secrets or node state ---
# Cryptographic key material of any form
*.key
*.pem
*.p12
*.pfx
identity.json
node_identity*
secrets/

# Local node databases (contain operational data)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Environment / credentials
.env
.env.*
!.env.example

# Local AI model weights (large, provisioned out of band; see docs/ai/PROVISIONING.md)
ai/models/*
!ai/models/.gitkeep
!ai/models/README.md
*.gguf
*.onnx
*.safetensors

# Local inference runtime: third-party prebuilt binaries, provisioned by the
# operator and verified against ai/models/README.md. Never vendored here.
ai/runtime/
